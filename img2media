import mediapipe as mp
import cv2
import os
import pandas as pd
from tqdm import tqdm

dataset_path = "train"  
output_csv = "image_data.csv"


mp_hands = mp.solutions.hands
hands = mp_hands.Hands(static_image_mode=True, max_num_hands=1)
all_data = []

for label in sorted(os.listdir(dataset_path)):
    label_path = os.path.join(dataset_path, label)
    if not os.path.isdir(label_path):
        continue

    print(f"Processing label: {label}")
    for img_file in tqdm(os.listdir(label_path)[:500]):
        img_path = os.path.join(label_path, img_file)
        img = cv2.imread(img_path)

        if img is None:
            continue

        img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
        result = hands.process(img_rgb)
        if not result.multi_hand_landmarks and label == 'nothing':
           all_data.append([0]*63 + ['nothing'])  
        if result.multi_hand_landmarks:
            hand_landmarks = result.multi_hand_landmarks[0]
            x = [lm.x for lm in hand_landmarks.landmark]
            y = [lm.y for lm in hand_landmarks.landmark]
            z = [lm.z for lm in hand_landmarks.landmark]
            features = x + y + z + [label]
            all_data.append(features)

# Save to CSV
columns = [f'x{i}' for i in range(21)] + [f'y{i}' for i in range(21)] + [f'z{i}' for i in range(21)] + ['label']
df = pd.DataFrame(all_data, columns=columns)
df.to_csv(output_csv, index=False)
print(f"Saved landmark data to {output_csv}")
