import mediapipe as mp
import cv2
import os
import pandas as pd
from tqdm import tqdm
from collections import defaultdict

DATASET_PATH = "train"  # path to folder with letter subfolders
OUTPUT_CSV = "hand.csv"
SAMPLES_PER_CLASS = 500

mp_hands = mp.solutions.hands
hands = mp_hands.Hands(static_image_mode=False, max_num_hands=1, min_detection_confidence=0.5)

data = []
counts = defaultdict(int)

# 63 features (21 landmarks × x, y, z) + 1 label
columns = [f"x{i}" for i in range(21)] + [f"y{i}" for i in range(21)] + [f"z{i}" for i in range(21)] + ["label"]

print("⚡ Extracting landmarks...")

for label in sorted(os.listdir(DATASET_PATH)):
    label_path = os.path.join(DATASET_PATH, label)
    if not os.path.isdir(label_path):
        continue

    print(f"🔠 Processing label '{label}'")
    image_files = os.listdir(label_path)
    i = 0

    with tqdm(total=SAMPLES_PER_CLASS, desc=f"Collecting for '{label}'") as pbar:
        while counts[label] < SAMPLES_PER_CLASS and i < len(image_files):
            img_file = image_files[i]
            img_path = os.path.join(label_path, img_file)
            img = cv2.imread(img_path)

            i += 1
            if img is None:
                continue

            img = cv2.resize(img, (256, 256))
            rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
            results = hands.process(rgb)
            if not results.multi_hand_landmarks and label == 'nothing':
                         data.append([0]*63 + ['nothing']) 
            if results.multi_hand_landmarks:
                lm = results.multi_hand_landmarks[0]
                x = [point.x for point in lm.landmark]
                y = [point.y for point in lm.landmark]
                z = [point.z for point in lm.landmark]
                data.append(x + y + z + [label])
                counts[label] += 1
                pbar.update(1)

print("✅ Finished collecting all classes.")

# Convert to DataFrame and save
df = pd.DataFrame(data, columns=columns)
df.to_csv(OUTPUT_CSV, index=False)
print(f"📁 Saved final dataset to: {OUTPUT_CSV}")
